{
  "dashboard": {
    "title": "System Monitoring Dashboard",
    "description": "Comprehensive monitoring dashboard for system metrics",
    "tags": ["monitoring", "prometheus", "system"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "CPU Utilization %",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "interval": "15s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            },
            "mappings": [],
            "color": {"mode": "thresholds"}
          }
        }
      },
      {
        "id": 2,
        "title": "CPU Load Average",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "node_load1",
          "legendFormat": "1-min",
          "interval": "15s"
        }, {
          "expr": "node_load5",
          "legendFormat": "5-min",
          "interval": "15s"
        }, {
          "expr": "node_load15",
          "legendFormat": "15-min",
          "interval": "15s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "100 * (1 - ((node_memory_MemAvailable_bytes) / (node_memory_MemTotal_bytes)))",
          "legendFormat": "Memory Used",
          "interval": "15s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            },
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 4,
        "title": "RAM Usage Breakdown",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
        "targets": [{
          "expr": "node_memory_MemFree_bytes",
          "legendFormat": "Free"
        }, {
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "Cached"
        }, {
          "expr": "node_memory_Buffers_bytes",
          "legendFormat": "Buffers"
        }, {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Cached_bytes - node_memory_Buffers_bytes",
          "legendFormat": "Used"
        }],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "min": 0
          }
        }
      },
      {
        "id": 5,
        "title": "Disk Space Usage",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6},
        "targets": [{
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"}))",
          "legendFormat": "{{mountpoint}}",
          "interval": "30s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Disk I/O",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6},
        "targets": [{
          "expr": "rate(node_disk_read_bytes_total[5m])",
          "legendFormat": "Read {{device}}"
        }, {
          "expr": "rate(node_disk_written_bytes_total[5m])",
          "legendFormat": "Write {{device}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 7,
        "title": "Network Traffic",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 6},
        "targets": [{
          "expr": "rate(node_network_receive_bytes_total[5m]) * 8",
          "legendFormat": "In {{device}}"
        }, {
          "expr": "rate(node_network_transmit_bytes_total[5m]) * 8",
          "legendFormat": "Out {{device}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "bps",
            "min": 0
          }
        }
      },
      {
        "id": 8,
        "title": "Network Errors",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 6},
        "targets": [{
          "expr": "rate(node_network_receive_errs_total[5m])",
          "legendFormat": "Receive Errors {{device}}"
        }, {
          "expr": "rate(node_network_transmit_errs_total[5m])",
          "legendFormat": "Transmit Errors {{device}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "HTTP Response Count Total",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
        "targets": [{
          "expr": "sum(rate(nginx_http_response_count_total[5m])) by (status)",
          "legendFormat": "Status {{status}}"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 10,
        "title": "HTTP Response Size Bytes",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
        "targets": [{
          "expr": "rate(nginx_http_response_size_bytes_sum[5m]) / rate(nginx_http_response_size_bytes_count[5m])",
          "legendFormat": "Avg Response Size"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "min": 0
          }
        }
      },
      {
        "id": 11,
        "title": "HTTP Status Codes",
        "type": "piechart",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 18},
        "targets": [{
          "expr": "sum(rate(nginx_http_response_count_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }],
        "options": {
          "pieType": "pie",
          "displayLabels": ["percent", "name"],
          "legend": {
            "show": true,
            "values": true
          }
        }
      },
      {
        "id": 12,
        "title": "System Uptime",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 18},
        "targets": [{
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": "{{instance}}",
          "interval": "60s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 0,
            "color": {"mode": "continuous-BlPu"}
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 13,
        "title": "Process Count",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 18},
        "targets": [{
          "expr": "node_procs_running",
          "legendFormat": "Running",
          "interval": "15s"
        }, {
          "expr": "node_procs_blocked",
          "legendFormat": "Blocked",
          "interval": "15s"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 500},
                {"color": "red", "value": 1000}
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s"
  },
  "folderId": 0,
  "overwrite": true
}
