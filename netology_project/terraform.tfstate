        {
          "schema_version": 0,
          "attributes": {
            "content": "[bastion]\n89.169.131.251\n\n[webservers]\n10.0.1.18\t\t\t\t# 0 - первый интерфейс машины\n10.0.2.5\n  \n[prometheus]\n10.0.1.24\n\n[grafana]\n10.0.1.21\n\n[elastic]\n10.0.1.11\n\n[kibana]\n10.0.1.15\n  \n[monitoring_targets:children]  # Группа всех хостов для мониторинга\nwebservers\nprometheus\n  \n[logging_targets:children]     # Группа всех хостов для сбора логов\nwebservers\nelastic\n  \n[webservers:vars]\nansible_ssh_common_args='-o ProxyCommand=\"ssh -p 22 -W %h:%p -q mike@89.169.131.251\"'\t\t# Для того, чтобы попасть на web-сервера надо пойти через бастион\n  \n[prometheus:vars]\nansible_ssh_common_args='-o ProxyCommand=\"ssh -p 22 -W %h:%p -q mike@89.169.131.251\"'\t\t# Для того, чтобы попасть на prometheus надо пойти через бастион\n\n[grafana:vars]\nansible_ssh_common_args='-o ProxyCommand=\"ssh -p 22 -W %h:%p -q mike@89.169.131.251\"'\n\n[elastic:vars]\nansible_ssh_common_args='-o ProxyCommand=\"ssh -p 22 -W %h:%p -q mike@89.169.131.251\"'\n\n[kibana:vars]\nansible_ssh_common_args='-o ProxyCommand=\"ssh -p 22 -W %h:%p -q mike@89.169.131.251\"'\n",
